{
  "name": "escolas-brasil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "prepare:tiles": "node --max-old-space-size=8192 scripts/prepare-tiles.mjs",
    "validate:tiles": "node --max-old-space-size=8192 scripts/validate-tiles.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "validate:filter": "node scripts/validate-filter.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@maplibre/geojson-vt": "^6.3.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
